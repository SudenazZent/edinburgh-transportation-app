    <!-- FAQ -->
    <string name="faq_title">Frequently Asked Questions</string>

    <string name="faq_login_question">How can I log in?</string>
    <string name="faq_login_answer">You can log in with your email address and password. If you don\'t have an account, you can register.</string>

    <string name="faq_add_card_question">How can I add my card?</string>
    <string name="faq_add_card_answer">You can scan your card with NFC or add your card manually from the My Cards section.</string>

    <string name="faq_top_up_question">How can I top up my card?</string>
    <string name="faq_top_up_answer">You can select your card in the My Cards section and access the balance top-up screen.</string>

    <string name="faq_routes_question">How can I view the routes?</string>
    <string name="faq_routes_answer">You can view bus and tram routes from the Routes section in the bottom menu.</string>

    <string name="faq_stops_question">How can I view the stops?</string>
    <string name="faq_stops_answer">You can view stops in Edinburgh and get information about them from the Map section.</string>

    <string name="faq_journey_question">How can I plan a journey?</string>
    <string name="faq_journey_answer">You can select the Plan Journey option on the Home screen, choose your departure and destination stops, and search for a suitable journey.</string>

    <string name="faq_notifications_question">Where can I see my notifications?</string>
    <string name="faq_notifications_answer">You can view your notifications by tapping the notification icon in the top-right corner of the Home screen.</string>

    <string name="faq_share_question">How can I share the app?</string>
    <string name="faq_share_answer">You can share the app using the Share App option in the Settings section.</string>

