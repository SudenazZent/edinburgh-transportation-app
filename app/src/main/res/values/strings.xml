    <!-- FAQ -->
    <string name="faq_title">Sık Sorulan Sorular</string>

    <string name="faq_login_question">Nasıl giriş yapabilirim?</string>
    <string name="faq_login_answer">E-posta adresiniz ve şifreniz ile giriş yapabilirsiniz. Hesabınız yoksa kayıt olabilirsiniz.</string>

    <string name="faq_add_card_question">Kartımı nasıl ekleyebilirim?</string>
    <string name="faq_add_card_answer">Kartlarım bölümünden NFC ile kartınızı okutabilir veya kartınızı manuel olarak ekleyebilirsiniz.</string>

    <string name="faq_top_up_question">Kartıma nasıl bakiye yükleyebilirim?</string>
    <string name="faq_top_up_answer">Kartlarım bölümünden kartınızı seçerek bakiye yükleme ekranına ulaşabilirsiniz.</string>

    <string name="faq_routes_question">Hatları nasıl görüntüleyebilirim?</string>
    <string name="faq_routes_answer">Alt menüde bulunan Hatlar bölümünden otobüs ve tramvay hatlarını görüntüleyebilirsiniz.</string>

    <string name="faq_stops_question">Durakları nasıl görüntüleyebilirim?</string>
    <string name="faq_stops_answer">Harita bölümünden Edinburgh\'daki durakları görüntüleyebilir ve duraklar hakkında bilgi alabilirsiniz.</string>

    <string name="faq_journey_question">Yolculuk nasıl planlanır?</string>
    <string name="faq_journey_answer">Ana Sayfa\'daki Yolculuk Planla seçeneğinden başlangıç ve varış duraklarını seçerek uygun bir yolculuk arayabilirsiniz.</string>

    <string name="faq_notifications_question">Bildirimleri nereden görebilirim?</string>
    <string name="faq_notifications_answer">Ana Sayfa\'nın sağ üst kısmındaki bildirim simgesine dokunarak bildirimlerinizi görüntüleyebilirsiniz.</string>

    <string name="faq_share_question">Uygulamayı nasıl paylaşabilirim?</string>
    <string name="faq_share_answer">Ayarlar bölümündeki Uygulamayı Paylaş seçeneğini kullanarak uygulamayı paylaşabilirsiniz.</string>

    <string name="faq_close_answer">Cevabı kapat</string>
    <string name="faq_open_answer">Cevabı aç</string>


